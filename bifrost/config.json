{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "groq": {
      "keys": [{ "name": "groq-1", "value": "env.GROQ_API_KEY", "models": ["*"], "weight": 1.0 }]
    },
    "openrouter": {
      "keys": [{ "name": "openrouter-1", "value": "env.OPENROUTER_API_KEY", "models": ["*"], "weight": 1.0 }]
    },
    "gemini": {
      "keys": [{ "name": "gemini-1", "value": "env.GEMINI_API_KEY", "models": ["*"], "weight": 1.0 }]
    },
    "cerebras": {
      "keys": [{ "name": "cerebras-1", "value": "env.CEREBRAS_API_KEY", "models": ["*"], "weight": 1.0 }]
    },
    "openai": {
      "keys": [{ "name": "openai-judge", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1.0 }]
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-judge",
        "name": "judge",
        "value": "env.BIFROST_JUDGE_VK",
        "is_active": true,
        "provider_configs": [
          { "id": 1, "provider": "openai", "allowed_models": ["*"], "key_ids": ["*"], "weight": 1 }
        ]
      }
    ],
    "budgets": [
      { "id": "budget-judge", "virtual_key_id": "vk-judge", "max_limit": 10.0, "reset_duration": "1M" }
    ]
  }
}
